# Copy to .env and edit. Every key is optional; see docs/configuration.md.

# Where data lives (raw/bronze/silver per source, matching intermediates)
MORTGAGE_DATA_DIR=/path/to/mortgage_data
# Final crosswalks, one folder per workflow (default: ./crosswalk)
# MORTGAGE_DATA_CROSSWALK_DIR=/path/to/crosswalk

# HTTP User-Agent for downloads (default: a desktop browser string)
# MORTGAGE_DATA_USER_AGENT=

# Credentials for sources that need them
# GNMA_EMAIL=you@example.com
# GNMA_ANSWER=
# USPS_CROSSWALK_API_KEY=
# FRED_API_KEY=
